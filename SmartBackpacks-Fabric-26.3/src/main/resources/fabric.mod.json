{
  "schemaVersion": 1,
  "id": "smartbackpacks",
  "version": "${version}",
  "name": "Smart Backpacks",
  "description": "Portable storage backpacks with safe per-item inventories and room to grow into upgrades, colors, and utility modules.",
  "authors": [
    "Team SmartStreamLabs"
  ],
  "license": "All Rights Reserved",
  "icon": "smartbackpacks.png",
  "environment": "*",
  "mixins": [
    "smartbackpacks.mixins.json"
  ],
  "accessWidener": "smartbackpacks.accesswidener",
  "entrypoints": {
    "main": [
      "com.teamsmartstreamlabs.smartbackpacks.fabric.SmartBackpacksFabric"
    ],
    "client": [
      "com.teamsmartstreamlabs.smartbackpacks.fabric.client.SmartBackpacksFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}"
  },
  "suggests": {
    "trinkets_updated": "*"
  }
}
